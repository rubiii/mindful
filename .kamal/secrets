# Kamal 2 Secrets Configuration
#
# This file defines how secrets are imported into Kamal from environment variables,
# password managers, or files. This file is SAFE TO COMMIT because it contains no
# actual secret values - only instructions on where to find them.
#
# For local development, add these variables to your .env file (see .env.example).
# The bin/kamal wrapper automatically loads them via dotenv-rails.
#
# For CI/CD, set these as repository secrets/environment variables.

# === Registry Password ===
# GitHub Container Registry Personal Access Token
# Needs 'read:packages' and 'write:packages' scopes
# Get from: https://github.com/settings/tokens
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# === Rails Master Key ===
# Import from environment variable
# Get from config/master.key file on your local machine
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# === PostgreSQL Password ===
# Used by the postgres accessory defined in config/deploy.yml
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# === Database Connection URLs ===
# These use the POSTGRES_PASSWORD variable above
# The host 'mindful-postgres' matches the service name + accessory name
DATABASE_URL=$DATABASE_URL
CACHE_DATABASE_URL=$CACHE_DATABASE_URL
CABLE_DATABASE_URL=$CABLE_DATABASE_URL

# === Hetzner Object Storage (S3-compatible) ===
# Get these from Hetzner Cloud Console > Object Storage
HETZNER_ACCESS_KEY_ID=$HETZNER_ACCESS_KEY_ID
HETZNER_SECRET_ACCESS_KEY=$HETZNER_SECRET_ACCESS_KEY
HETZNER_BUCKET=$HETZNER_BUCKET
HETZNER_REGION=$HETZNER_REGION
HETZNER_ENDPOINT=$HETZNER_ENDPOINT