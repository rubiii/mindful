# Environment Variables Configuration
# Copy this file to .env for local development: cp .env.example .env

# Application Configuration
PORT=3000
RAILS_MAX_THREADS=3

# Mailer Configuration
MAILER_SENDER=noreply@example.com
MAILER_HOST=localhost:3000

# SMTP Configuration (optional)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_DOMAIN=example.com

# Production Database URLs
# DATABASE_URL=postgresql://user:pass@host:5432/mindful_production
# CACHE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_cache
# QUEUE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_queue
# CABLE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_cable

# === Kamal Deployment Secrets ===
# These are only needed when deploying with Kamal
# Generate values as described in docs/deployment.md

# Rails Master Key (copy from config/master.key)
RAILS_MASTER_KEY=your_rails_master_key_here

# GitHub Container Registry Personal Access Token
# Get from: https://github.com/settings/tokens
# Needs scopes: read:packages, write:packages
KAMAL_REGISTRY_PASSWORD=ghp_your_github_token_here

# PostgreSQL Password (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=your_generated_password_here

# Database URLs (replace password with POSTGRES_PASSWORD above)
DATABASE_URL=postgresql://mindful:your_password@mindful-postgres:5432/mindful_production
CACHE_DATABASE_URL=postgresql://mindful:your_password@mindful-postgres:5432/mindful_production_cache
CABLE_DATABASE_URL=postgresql://mindful:your_password@mindful-postgres:5432/mindful_production_cable

# Hetzner Object Storage (S3-compatible)
# Get from: Hetzner Cloud Console > Object Storage
HETZNER_ACCESS_KEY_ID=your_access_key_here
HETZNER_SECRET_ACCESS_KEY=your_secret_key_here
HETZNER_BUCKET=your-bucket-name
HETZNER_REGION=fsn1
HETZNER_ENDPOINT=https://fsn1.your-objectstorage.com
