# Environment Variables Configuration
# Copy this file to .env for local development: cp .env.example .env

# Application Configuration
PORT=3000
RAILS_MAX_THREADS=3

# Mailer Configuration
MAILER_SENDER=noreply@example.com
MAILER_HOST=localhost:3000

# SMTP Configuration (optional)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_DOMAIN=example.com

# Production Database URLs
# DATABASE_URL=postgresql://user:pass@host:5432/mindful_production
# CACHE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_cache
# QUEUE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_queue
# CABLE_DATABASE_URL=postgresql://user:pass@host:5432/mindful_production_cable
