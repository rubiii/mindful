<%# locals: (user:) %>

<tr id="<%= dom_id(user) %>">
  <td><%= user.email %></td>
  <td><%= t("locales.#{user.locale}") %></td>
  <td><%= t("roles.#{user.role}") %></td>
  <td><%= t(".account_state.#{user.account_state}") %></td>
  <%# TODO: right align content in td %>
  <td class="has-text-right">
    <div class="buttons is-right">
      <%= link_to t(".edit"), edit_admin_user_path(user), class: "button is-small is-info is-light", data: { turbo_frame: "modal" } %>
      <%= button_to t(".delete"), [:admin, user], method: :delete, class: "button is-small is-danger is-light", form: { data: { turbo_confirm: t(".confirm_delete", email: user.email) } } %>
    </div>
  </td>
</tr>
